{
    "name": "sahibinden-bot",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Local-first sahibinden.com real-estate crawling and intelligence application",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "crawl": "tsx apps/cli/src/index.ts",
        "build": "tsc -b tsconfig.json",
        "typecheck": "tsc -b tsconfig.json",
        "test": "vitest run",
        "lint": "eslint .",
        "clean": "git clean -fdx packages apps --exclude node_modules || true"
    },
    "pnpm": {
        "ignoredBuiltDependencies": ["esbuild", "puppeteer"]
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "@types/node": "^24.0.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^9.0.0",
        "tsx": "^4.19.0",
        "typescript": "^5.6.0",
        "vitest": "^3.0.0"
    }
}
