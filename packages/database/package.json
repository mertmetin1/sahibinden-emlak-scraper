{
    "name": "@sahibindenbot/database",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Prisma schema, migrations, client factory and repository layer. The ONLY package that imports @prisma/client.",
    "exports": {
        ".": "./src/index.ts"
    },
    "scripts": {
        "db:generate": "prisma generate",
        "db:migrate": "prisma migrate deploy",
        "db:push": "prisma db push",
        "db:seed": "tsx prisma/seed.ts",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "vitest run"
    },
    "dependencies": {
        "@prisma/client": "^6.19.0",
        "@sahibindenbot/shared": "workspace:*"
    },
    "devDependencies": {
        "prisma": "^6.19.0"
    }
}
